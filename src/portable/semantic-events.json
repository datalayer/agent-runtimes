{
  "version": 1,
  "about": "The semantic agent events a chat host renders (Slack, Discord:  DC-005, S-004, S-205), and the AG-UI events of agent-runtimes' session API (agent_runtimes/routes/apps.py, agent_runtimes/loop/apps/sessions.py, agent_runtimes/loop/apps/external_turns.py) each reduces to. src/portable/semanticOfAgUi.ts reduces every case (src/portable/__tests__/semantic.unit.test.ts); agent_runtimes/tests/test_semantic_events_contract.py holds the cases to what the runtime emits.",
  "kinds": [
    "text",
    "progress",
    "tool",
    "approval",
    "table",
    "file",
    "citation",
    "ask",
    "completion",
    "stop",
    "error"
  ],
  "producers": {
    "text": "AG-UI TEXT_MESSAGE_CONTENT / TEXT_MESSAGE_CHUNK delta",
    "progress": "AG-UI STEP_STARTED stepName",
    "tool": "AG-UI TOOL_CALL_START (running), TOOL_CALL_RESULT (complete, or failed when success is false)",
    "approval": "AG-UI TOOL_CALL_RESULT whose result says pending_approval; the decision itself arrives as an approval.requested delivery",
    "table": "a Markdown table in the answer (src/portable/semantic.ts answerParts); no AG-UI event carries one",
    "file": "none in agent-runtimes 1.5.45: reserved, rendered as a safe HTTPS link when produced",
    "citation": "an HTTPS Markdown link in the answer (answerParts); no AG-UI event carries one",
    "ask": "AG-UI RUN_FINISHED with result.asking (agent_runtimes/loop/apps/sessions.py question_of); the run stream carries no loop.ask event",
    "completion": "AG-UI RUN_FINISHED without asking",
    "stop": "the host itself, after its own Stop: a stopped session's stream ends without RUN_FINISHED or RUN_ERROR (agent_runtimes/loop/apps/sessions.py stop, _close); no AG-UI event carries it",
    "error": "AG-UI RUN_ERROR message"
  },
