{
  "description": "Every Reactor contribution point of this protocol's plugin, in both languages (AGENT_PROTOCOLS §3.1). test_protocols_reactor_points.py and src/protocols/reactorPoints.unit.test.ts hold each language to this file. A point whose `extension` is true is an extension the protocol defines; its contributions are implementations of it. `default` is the contribution id of the plugin's own default (order 100), null when a host must contribute one. `resolution` is `single` (the lowest order answers; two at the same order fail closed) or `all` (every contribution is used).",
  "plugin": {
    "python": "agent-runtimes.protocols.pact",
    "typescript": "@datalayer/agent-runtimes/protocols/pact"
  },
  "points": [
    {
      "id": "pact.signer",
      "python": "agent_runtimes.protocols.pact.plugin:SIGNERS",
      "typescript": "PactSigners",
      "contract": "HttpSigner",
      "members": [
        "keyid",
        "algorithm",
        "sign"
      ],
      "default": null,
      "resolution": "single",
      "tenant": null,
      "extension": false,
      "note": "ES256: the host's key, as web_bot_auth.signer's."
    },
    {
      "id": "pact.delegationStore",
      "python": "agent_runtimes.protocols.pact.plugin:DELEGATION_STORES",
      "typescript": "PactDelegationStores",
      "contract": "DelegationStore",
      "members": [
        "put",
        "get",
        "delete"
      ],
      "default": {
        "python": "memory",
        "typescript": "memory"
      },
      "resolution": "single",
      "tenant": null,
      "extension": false,
      "note": "IAM custody on Datalayer (PI-11)."
    },
    {
      "id": "pact.receiptStore",
      "python": "agent_runtimes.protocols.pact.plugin:RECEIPT_STORES",
      "typescript": "PactReceiptStores",
      "contract": "ReceiptStore",
      "members": [
        "keep"
      ],
      "default": {
        "python": "memory",
        "typescript": "memory"
      },
      "resolution": "single",
      "tenant": null,
      "extension": false,
      "note": "The application's record on Datalayer (R-07)."
    },
    {
      "id": "pact.extension.delegated",
      "python": "agent_runtimes.protocols.pact.plugin:DELEGATED",
      "typescript": "PactDelegatedProfiles",
      "contract": "DelegatedProfile",
      "members": [
        "grant_type"
      ],
      "default": {
        "python": "device-code",
        "typescript": "device-code"
      },
      "resolution": "single",
      "tenant": null,
      "extension": true,
      "note": "PACT's optional Delegated profile (§5); without it, Identity alone."
    }
  ]
}
