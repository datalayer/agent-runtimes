{
  "description": "Every Reactor contribution point of this protocol's plugin, in both languages (AGENT_PROTOCOLS §3.1). test_protocols_reactor_points.py and src/protocols/reactorPoints.unit.test.ts hold each language to this file. A point whose `extension` is true is an extension the protocol defines; its contributions are implementations of it. `default` is the contribution id of the plugin's own default (order 100), null when a host must contribute one. `resolution` is `single` (the lowest order answers; two at the same order fail closed) or `all` (every contribution is used).",
  "plugin": {
    "python": "agent-runtimes.protocols.a2a",
    "typescript": "@datalayer/agent-runtimes/protocols/a2a"
  },
  "points": [
    {
      "id": "a2a.extension.orchestration",
      "python": "agent_runtimes.protocols.a2a:ORCHESTRATION",
      "typescript": "A2AOrchestrationExtensions",
      "contract": "A2AExtension",
      "members": [
        "uri",
        "description",
        "required",
        "params"
      ],
      "default": {
        "python": "datalayer",
        "typescript": "datalayer"
      },
      "resolution": "single",
      "tenant": null,
      "extension": true,
      "uri": "https://datalayer.ai/extensions/orchestration/v1"
    },
    {
      "id": "a2a.extension.face",
      "python": "agent_runtimes.protocols.a2a:FACE",
      "typescript": "A2AFaceExtensions",
      "contract": "A2AExtension",
      "members": [
        "uri",
        "description",
        "required",
        "params"
      ],
      "default": {
        "python": "datalayer",
        "typescript": "datalayer"
      },
      "resolution": "single",
      "tenant": null,
      "extension": true,
      "uri": "https://datalayer.ai/extensions/face/v1"
    },
    {
      "id": "a2a.extension.other",
      "python": "agent_runtimes.protocols.a2a:OTHER",
      "typescript": "A2AOtherExtensions",
      "contract": "A2AExtension",
      "members": [
        "uri",
        "description",
        "required",
        "params"
      ],
      "default": null,
      "resolution": "all",
      "tenant": null,
      "extension": true,
      "note": "Any other A2A extension, its contribution id its URI."
    }
  ]
}
